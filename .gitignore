# Variáveis de ambiente com credenciais — NUNCA comitar
.env

# Dados locais do Claude Code (memória, planos, configurações de sessão)
.claude/

# Artefatos do instalador de skills/agentes (tooling local, não faz parte da aplicação)
.agents/
skills-lock.json

# E-mails de dev (gerados em modo de teste local)
storage/email_log/*.html

# Arquivos Temporarios e Uploads
public/uploads/*
!public/uploads/.gitkeep
!public/uploads/.htaccess
public/temp/*

# Anexos de requerimento (dados pessoais/sensiveis — LGPD): fora do webroot, nunca no git
storage/request_files/*
!storage/request_files/.gitkeep
!public/temp/.gitkeep

# Dependencias e Cache (caso use composer futuramente)
vendor/
node_modules/

# Logs e arquivos de sistema
*.log
.DS_Store
Thumbs.db
